{
  "name": "gestplan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:homolog": "vite --mode homolog",
    "build": "tsc -b && vite build",
    "build:homolog": "tsc -b && vite build --mode homolog",
    "preview": "vite preview",
    "tipos": "supabase gen types typescript --local > src/lib/banco.types.ts",
    "tipos:remoto": "supabase gen types typescript --linked > src/lib/banco.types.ts",
    "tipos:homolog": "supabase gen types typescript --project-id REF_DO_HOMOLOG > src/lib/banco.types.ts"
  },
  "dependencies": {
    "@fontsource-variable/urbanist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@supabase/supabase-js": "^2.58.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
