# Copie para .env e preencha com os valores do seu projeto Supabase
# (Painel > Project Settings > API). Nunca comite o .env.
#
# A chave anon é publica por natureza: quem protege o dado e a RLS, nao ela.
# A service_role NUNCA entra aqui nem em nenhum arquivo do front.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
